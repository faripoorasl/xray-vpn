<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Primary: local packages (no internet required) -->
    <add key="local" value="./local-packages" />
    <!-- Fallback: nuget.org (only used if local package not found) -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!-- Cache packages locally in the project folder -->
    <add key="globalPackagesFolder" value="./packages" />
  </config>
</configuration>
