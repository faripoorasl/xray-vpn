<UserControl x:Class="XrayVpnApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- General -->
            <TextBlock Text="{DynamicResource SettingsGeneral}" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Language}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LangCombo" Margin="0,0,0,12" SelectionChanged="Lang_Changed">
                        <ComboBoxItem Content="فارسی" Tag="fa"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              x:Name="StartWithWindows" Content="{DynamicResource StartWithWindows}" Margin="0,0,0,12"/>
                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                              x:Name="MinimizeToTray" Content="{DynamicResource MinimizeToTray}" Margin="0,0,0,12"/>
                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                              x:Name="CloseToTray" Content="{DynamicResource CloseToTray}" Margin="0,0,0,12"/>
                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                              x:Name="AutoConnect" Content="{DynamicResource AutoConnectOnStart}"/>
                </Grid>
            </Border>

            <!-- TUN -->
            <TextBlock Text="{DynamicResource SettingsTun}" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource TunAdapterName}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TunName" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource TunIp}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TunIpBox" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource TunGateway}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TunGwBox" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource TunMtu}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TunMtuBox"/>
                </Grid>
            </Border>

            <!-- DNS -->
            <TextBlock Text="{DynamicResource SettingsDns}" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource RemoteDns}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RemoteDnsBox" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LocalDns}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="LocalDnsBox" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource DohUrl}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="DohUrlBox" Margin="0,0,0,12"/>

                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="FakeDns" Content="{DynamicResource EnableFakeDns}" Margin="0,0,0,12"/>
                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DohEnabled" Content="{DynamicResource DnsOverHttps}"/>
                </Grid>
            </Border>

            <!-- Routing -->
            <TextBlock Text="{DynamicResource SettingsRouting}" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="BypassLan" Content="{DynamicResource BypassLan}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="BypassIran" Content="{DynamicResource BypassIran}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="BlockAds" Content="{DynamicResource BlockAds}"/>
                </StackPanel>
            </Border>

            <!-- Xray Core -->
            <TextBlock Text="{DynamicResource SettingsXray}" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource XrayLogLevel}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LogLevelCombo" Margin="0,0,0,12">
                        <ComboBoxItem Content="Debug" Tag="0"/>
                        <ComboBoxItem Content="Info" Tag="1"/>
                        <ComboBoxItem Content="Warning" Tag="2"/>
                        <ComboBoxItem Content="Error" Tag="3"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SocksPort}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SocksPortBox" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource HttpPort}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="HttpPortBox" Margin="0,0,0,12"/>

                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MuxEnabled" Content="{DynamicResource EnableMux}" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource MuxConcurrency}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="MuxConcBox"/>
                </Grid>
            </Border>

            <!-- Save -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Save}" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click" Padding="24,10" Margin="0,0,8,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
