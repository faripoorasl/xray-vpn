<Window x:Class="XrayVpnApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XrayVpnApp.ViewModels"
        xmlns:conv="clr-namespace:XrayVpnApp.Converters"
        Title="{DynamicResource AppTitle}"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="MainWindow_OnLoaded"
        Closing="MainWindow_OnClosing"
        StateChanged="MainWindow_OnStateChanged">

    <Window.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>
        <conv:LatencyToColorConverter x:Key="LatencyToColor"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header / Title Bar ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                Padding="16,10" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + App name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource AppTitle}"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status indicator -->
                <Border Grid.Column="2"
                        Background="{Binding StatusBackground}"
                        CornerRadius="14"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                 Fill="{Binding StatusDotColor}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Connection Bar (always visible) ===== -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}">
            <TabControl x:Name="MainTabs" TabStripPlacement="Top" Padding="0">
                <TabItem Header="{DynamicResource TabServers}">
                    <Frame x:Name="ServersFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
                <TabItem Header="{DynamicResource TabSubscriptions}">
                    <Frame x:Name="SubscriptionsFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
                <TabItem Header="{DynamicResource TabSpeedTest}">
                    <Frame x:Name="SpeedTestFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
                <TabItem Header="{DynamicResource TabSettings}">
                    <Frame x:Name="SettingsFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
                <TabItem Header="{DynamicResource TabLogs}">
                    <Frame x:Name="LogsFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
                <TabItem Header="{DynamicResource TabAbout}">
                    <Frame x:Name="AboutFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ===== Connection Action Bar ===== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Live stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ConnectedServer}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectedServerName}"
                               Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,0,24,0"/>
                    <TextBlock Text="↓" FontSize="16" Margin="0,0,4,0" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="{Binding DownloadSpeedDisplay}" Margin="0,0,16,0"/>
                    <TextBlock Text="↑" FontSize="16" Margin="0,0,4,0" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="{Binding UploadSpeedDisplay}" Margin="0,0,16,0"/>
                    <TextBlock Text="{DynamicResource Duration}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectedDurationDisplay}"/>
                </StackPanel>

                <!-- Connect/Disconnect button -->
                <Button Grid.Column="1"
                        x:Name="ConnectBtn"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="140"
                        Click="ConnectBtn_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ConnectButtonIcon}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ConnectButtonText}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
