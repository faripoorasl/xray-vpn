# =====================================================
# .gitignore for C# / .NET 8 / WPF / Xray VPN project
# =====================================================

## ---- Visual Studio / Rider / VS Code ----
.vs/
.idea/
.vscode/
*.user
*.suo
*.userprefs
*.csproj.user
*.sln.docstates
*.rsuser

## ---- Build output ----
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
build/
artifacts/
publish/
*.dll.config
*.pdb

## ---- Test results ----
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

## ---- NuGet ----
# Note: local-packages/ folder IS tracked (contains pre-downloaded .nupkg files
# so users can build without internet access). See local-packages/.gitkeep
*.snupkg
.nuget/
packages/
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/
# Ignore user-downloaded packages but keep our pre-bundled ones
!local-packages/*.nupkg

## ---- Publish single-file output ----
*.exe.bak
*.dll.bak

## ---- Runtime files ----
*.log
*.log.*
log-*.txt
appsettings.*.local.json
*.local.json

## ---- User-specific settings ----
*.local.settings.json
settings.local.json
servers.local.json

## ---- OS junk ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*.swo
*~

## ---- Secrets / credentials ----
*.pfx
*.p12
*.key
*.pem
.env
.env.*
secrets.json
credentials.json

## ---- External dependencies ----
# These ARE now bundled in the repo (in src/XrayVpnApp/Resources/)
# so users can build completely offline (no internet needed).
# Previously they were git-ignored and downloaded by scripts/download-deps.ps1.
# Now we ship them as part of the source release for sanction-friendly install.
# !src/XrayVpnApp/Resources/xray.exe
# !src/XrayVpnApp/Resources/wintun.dll
# !src/XrayVpnApp/Resources/geoip.dat
# !src/XrayVpnApp/Resources/geosite.dat

## ---- App data (created at runtime) ----
*.dat.bak
config.json

## ---- Bundles / Archives ----
*.bundle
*.zip
*.tar.gz
*.7z
!src/XrayVpnApp.Installer/assets/*.zip

## ---- Generated installer output ----
installer-output/
Output/

## ---- Misc ----
*.cache
*.tmp
*.temp
*.bak
*.orig
*.rej
